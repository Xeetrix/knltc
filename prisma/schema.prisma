// ==============================================================================
// KNLTC (Japan Gateway) - Master Enterprise & CMS PostgreSQL Schema
// Supports 100% Website Content CMS + CRM, Visa Pipeline, LMS, Finance, B2B & HR
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  MAIN_ADMIN       // শেখ বাসেত (Managing Director & Super Admin)
  BRANCH_ADMIN     // ঢাকা ও খুলনা শাখা ব্যবস্থাপক
  TELE_COUNSELOR   // রিমোট ফিমেল ক্লায়েন্ট কমিউনিকেশন এক্সিকিউটিভ
  TEACHER          // আমির হোসেন (সিনিয়র সেন্সি) ও প্রশিক্ষকগণ
  B2B_AGENT        // Nexus Group, BWBS, ক্যাম্পাস অ্যাম্বাসেডর
  INVESTOR         // ১০ লক্ষ টাকার বিনিয়োগকারী (Open-Book Audit View)
  STUDENT          // শিক্ষার্থী ও ভিসা প্রার্থী (Portal & Progress View)
}

enum LeadSource {
  FACEBOOK_META
  WHATSAPP_DIRECT
  WEBSITE_FORM
  OFFICE_WALKIN
  B2B_REFERRAL
  SUB_AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELED
  OFFICE_VISIT_BOOKED
  ADMITTED
  ARCHIVED
}

enum ServiceInterest {
  STUDENT_VISA_REGULAR
  STUDENT_VISA_PREMIUM
  SSW_CONSTRUCTION_SPECIAL
  SSW_CAREGIVER
  SSW_AGRICULTURE
  SSW_FOOD_SERVICE
  TITP_TECHNICAL
  JAPANESE_N5
  JAPANESE_N4
}

enum DeliveryMode {
  ONLINE_LIVE
  OFFLINE_CLASSROOM
}

enum VisaCategory {
  STUDENT_VISA
  SSW_JOB
  TITP_INTERN
  GENERAL_LANGUAGE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  BANK_TRANSFER
  CASH_OFFICE
  AAMARPAY
  SSLCOMMERZ
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ------------------------------------------------------------------------------
// BRANCHES & USERS
// ------------------------------------------------------------------------------

model Branch {
  id              String      @id @default(uuid())
  code            String      @unique // "DHK-HQ", "KHULNA-01"
  name            String      // e.g. "Dhaka Head Office (VIP Road, Naya Paltan)"
  city            String      // "Dhaka", "Khulna"
  address         String
  phone           String
  email           String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users           User[]      @relation("BranchStaffAndStudents")
  batches         Batch[]
  crmLeads        CrmLead[]
  visaApplicants  VisaApplication[]
  transactions    FinancialTransaction[]

  @@map("branches")
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  phone           String
  whatsapp        String?
  passwordHash    String
  role            UserRole     @default(STUDENT)
  avatarUrl       String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branchId        String?
  branch          Branch?      @relation("BranchStaffAndStudents", fields: [branchId], references: [id], onDelete: SetNull)

  staffProfile    StaffProfile?
  enrollments     Enrollment[]
  visaApplications VisaApplication[]
  assignedLeads   CrmLead[]    @relation("AssignedCounselorLeads")

  @@index([role])
  @@index([branchId])
  @@map("users")
}

model StaffProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location             String   // "REMOTE", "DHAKA_OFFICE", "KHULNA_OFFICE"
  monthlyBaseSalary    Decimal  @db.Decimal(10, 2)
  callsTargetMonthly   Int      @default(600)
  callsCompleted       Int      @default(0)
  admissionsTarget     Int      @default(12)
  admissionsAchieved   Int      @default(0)
  performanceBonusBdt  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("staff_profiles")
}

// ------------------------------------------------------------------------------
// CRM & OMNI-CHANNEL LEADS
// ------------------------------------------------------------------------------

model CrmLead {
  id                  String          @id @default(uuid())
  name                String
  phone               String
  whatsapp            String
  email               String?
  city                String
  source              LeadSource      @default(WEBSITE_FORM)
  interest            ServiceInterest @default(STUDENT_VISA_REGULAR)
  status              LeadStatus      @default(NEW)
  education           String?
  japaneseProficiency String?         // "NONE", "LEARNING_N5", "PASSED_N4"
  studyGapYears       Int             @default(0)
  notes               String?         @db.Text
  followUpDate        DateTime?
  lastContactedAt     DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  branchId            String?
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedToUserId    String?
  assignedCounselor   User?           @relation("AssignedCounselorLeads", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([interest])
  @@index([source])
  @@map("crm_leads")
}

// ------------------------------------------------------------------------------
// VISA PIPELINE & 10-STEP KANBAN
// ------------------------------------------------------------------------------

model VisaApplication {
  id                  String       @id @default(uuid())
  trackingNo          String       @unique // e.g. KNLTC-VISA-2027-042
  applicantName       String
  phone               String
  packageType         String       // "REGULAR" (৳1.2L after visa) or "PREMIUM" (৳11L All-in-One)
  intakeSession       String       // "APRIL_2027", "JULY_2027", "OCTOBER_2027", "JANUARY_2028"
  stage               Int          @default(1) // 1 to 10
  targetSchool        String       // e.g. "HLA Gakuin (Hiroshima)"
  sponsorName         String?
  sponsorRelation     String?      // "FATHER", "MOTHER", "BROTHER"
  sponsorBank         String?
  sponsorBalanceBdt   Decimal?     @db.Decimal(12, 2)
  bankLoanAssistance  Boolean      @default(false)
  bankLoanBank        String?      // অগ্রণী, সোস্যাল ইসলামী, পূবালী
  coEStatus           String       @default("PENDING") // PENDING, APPROVED, REJECTED
  visaStatus          String       @default("IN_PROCESS") // IN_PROCESS, STAMPED, DEPARTED
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  branchId            String?
  branch              Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([trackingNo])
  @@map("visa_applications")
}

// ------------------------------------------------------------------------------
// LMS & EXTERNAL PORTAL BRIDGE (`npw.bd/knltc`)
// ------------------------------------------------------------------------------

model Course {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  level           String       // "N5", "N4", "IRODORI"
  durationMonths  Int          @default(3)
  fee             Decimal      @db.Decimal(10, 2) // 12,000 BDT
  discountedFee   Decimal?     @db.Decimal(10, 2)
  description     String       @db.Text
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  batches         Batch[]
  enrollments     Enrollment[]
  lessons         Lesson[]

  @@map("courses")
}

model Batch {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  scheduleTime    String
  deliveryMode    DeliveryMode @default(ONLINE_LIVE)
  meetingUrl      String?
  classroomRoom   String?
  seatsTotal      Int          @default(30)
  seatsBooked     Int          @default(0)
  createdAt       DateTime     @default(now())

  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  branchId        String
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  enrollments     Enrollment[]

  @@map("batches")
}

model Enrollment {
  id                   String        @id @default(uuid())
  enrollmentNo         String        @unique
  applicantName        String
  phone                String
  email                String?
  courseLevel          String        // N5, N4
  portalUsername       String?
  portalPasswordMasked String?
  portalFeeDeducted    Decimal       @default(2000) @db.Decimal(10, 2)
  netKnlTcMargin       Decimal       @default(10000) @db.Decimal(10, 2)
  credentialsSentViaWa Boolean       @default(false)
  progressPercentage   Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  courseId             String
  course               Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)

  batchId              String?
  batch                Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("enrollments")
}

model Lesson {
  id            String   @id @default(uuid())
  lessonNumber  Int
  titleBn       String
  titleEn       String
  titleJa       String
  tabCategory   String   // "ALPHABET", "KOTOBA", "GRAMMAR", "KAIWA"
  summaryBn     String?  @db.Text
  vocabularyJson Json?
  grammarPoints Json?
  audioUrl      String?
  createdAt     DateTime @default(now())

  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

// ------------------------------------------------------------------------------
// B2B & JAPANESE SCHOOL PARTNERS
// ------------------------------------------------------------------------------

model JapanesePartnerSchool {
  id                         String   @id @default(uuid())
  name                       String   // HLA Gakuin (Hiroshima)
  japaneseName               String   // HLA学院（広島）
  location                   String
  contactPerson              String   // Principal Fujii Keiko / Donaka-san
  email                      String
  commissionPerStudentYen    Int      @default(80000) // 80,000 JPY
  commissionPerStudentBdt    Decimal  @default(64000) @db.Decimal(10, 2)
  activeStudentsCount        Int      @default(0)
  totalCommissionReceivedYen BigInt   @default(0)
  status                     String   @default("ACTIVE_PARTNER")
  createdAt                  DateTime @default(now())

  @@map("partner_schools")
}

model B2bPartner {
  id                    String   @id @default(uuid())
  organizationName      String   // Nexus Group, BWBS Worldwide
  agentType             String   // INSTITUTIONAL, LOCAL_SUB_AGENT, CAMPUS_AMBASSADOR
  contactPerson         String
  phone                 String
  city                  String
  referredStudentsCount Int      @default(0)
  successfulVisasCount  Int      @default(0)
  agreedCommissionBdt   Decimal  @db.Decimal(10, 2)
  pendingCommissionBdt  Decimal  @default(0) @db.Decimal(10, 2)
  paidCommissionBdt     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())

  @@map("b2b_partners")
}

// ------------------------------------------------------------------------------
// FINANCE & INVESTOR OPEN-BOOK
// ------------------------------------------------------------------------------

model FinancialTransaction {
  id             String        @id @default(uuid())
  receiptNo      String        @unique
  date           DateTime      @default(now())
  studentName    String
  type           String        // COURSE_FEE, REGULAR_SERVICE_CHARGE, PREMIUM_PACKAGE_ADVANCE, MARKETING_META
  amountBdt      Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(BKASH)
  referenceOrTrx String?
  verifiedBy     String
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([type])
  @@map("financial_transactions")
}

model InvestorRecord {
  id                    String   @id @default(uuid())
  investorName          String
  totalCapitalBdt       Decimal  @default(1000000) @db.Decimal(12, 2)
  stampAgreementBdt     Int      @default(300)
  bankChequeNumber      String
  tenureMonths          Int      @default(12)
  profitSharePercentage Decimal  @default(10.0) @db.Decimal(4, 2)
  setupExpenseAllocated Decimal  @default(300000) @db.Decimal(10, 2) // 30%
  marketingAllocated    Decimal  @default(200000) @db.Decimal(10, 2) // 20%
  runwayAllocated       Decimal  @default(300000) @db.Decimal(10, 2) // 30%
  reserveAllocated      Decimal  @default(200000) @db.Decimal(10, 2) // 20%
  createdAt             DateTime @default(now())

  @@map("investor_records")
}

// ------------------------------------------------------------------------------
// BOOK STORE & PRODUCTS
// ------------------------------------------------------------------------------

model Product {
  id           String      @id @default(uuid())
  nameBn       String
  nameEn       String
  slug         String      @unique
  category     String      // TEXTBOOK, JLPT_PRACTICE, KANJI_SHEET
  price        Decimal     @db.Decimal(10, 2)
  salePrice    Decimal?    @db.Decimal(10, 2)
  stock        Int         @default(50)
  imageUrl     String?
  badgeBn      String?
  isPublished  Boolean     @default(true)
  description  String?     @db.Text
  createdAt    DateTime    @default(now())

  orderItems   OrderItem[]

  @@map("store_products")
}

model Order {
  id           String      @id @default(uuid())
  orderNo      String      @unique
  customerName String
  phone        String
  address      String      @db.Text
  deliveryArea String      // INSIDE_DHAKA, OUTSIDE_DHAKA
  deliveryFee  Decimal     @db.Decimal(10, 2)
  grandTotal   Decimal     @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(COD)
  trxId        String?
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]

  @@map("store_orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

// ------------------------------------------------------------------------------
// WEBSITE CMS & DYNAMIC CONTENT
// ------------------------------------------------------------------------------

model JobCircular {
  id                  String   @id @default(uuid())
  titleBn             String
  titleEn             String
  titleJa             String
  category            String   // SSW_CONSTRUCTION, SSW_CAREGIVER, SSW_AGRICULTURE
  salaryYen           String
  salaryBdtEquivalent String
  locationJapan       String
  openings            Int      @default(10)
  requirementsBn      String   @db.Text
  specialBenefitsBn   String   @db.Text // e.g. "JLPT N4 পাসদের ঢাকায় ফ্রি থাকা-খাওয়া ও স্কিল ট্রেনিং"
  isPublished         Boolean  @default(true)
  deadline            DateTime?
  createdAt           DateTime @default(now())

  @@map("job_circulars")
}

model SiteContent {
  id         String   @id @default("global-site-config")
  key        String   @unique
  valueJson  Json
  updatedAt  DateTime @updatedAt

  @@map("site_contents")
}
